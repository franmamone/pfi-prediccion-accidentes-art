# Opcional: solo si re-exportás datos desde un SQL Server propio.
# En la entrega el pipeline usa los parquet/csv de data/raw/ (--skip-export).

# PFI_SQL_SERVER=localhost
# PFI_SQL_DATABASE=PfiPrevencion
# PFI_SQL_TRUSTED_CONNECTION=yes
# PFI_SQL_DRIVER=ODBC Driver 17 for SQL Server

# Si PFI_SQL_TRUSTED_CONNECTION=no:
# PFI_SQL_USER=
# PFI_SQL_PASSWORD=
