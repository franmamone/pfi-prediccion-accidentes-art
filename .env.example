# Conexión SQL Server (export desde ml.vw_siniestros_accidente_ml)
PFI_SQL_SERVER=SQLSERVER
PFI_SQL_DATABASE=ART_CORE

# Autenticación Windows (recomendado en red corporativa)
PFI_SQL_TRUSTED_CONNECTION=yes

# Si PFI_SQL_TRUSTED_CONNECTION=no, completar usuario/contraseña:
# PFI_SQL_USER=
# PFI_SQL_PASSWORD=

# Driver ODBC (ajustar según instalación local)
PFI_SQL_DRIVER=ODBC Driver 17 for SQL Server
