<?xml version="1.0" encoding="utf-8"?>
<!-- Este PFI solo usa nuget.org (sin feeds corporativos). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
    <add key="Azure" value="true" />
  </disabledPackageSources>
</configuration>
